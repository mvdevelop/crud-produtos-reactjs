{
  "name": "React.js CRUD Development Environment",
  "description": "Professional development environment for React.js CRUD project with modern tooling and best practices",
  "context": "/home/marthamarinho/Programming/git-clones/crud-produtos-reactjs",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20",

  "features": [
    "git",
    "github-cli",
    "docker",
    "docker-compose",
    "node",
    "npm",
    "vscode",
    "yum",
    "wget",
    "gnupg",
    "bash"
  ],

  "extensions": [
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
    "eg2.vscode-typescript-eslint",
    "ritwickdey.vscode-lightweight-html-previewer",
    "waysfiddler.slack-channel-linker",
    "mhutchie.git-graph",
    "alefragnani.vscode-version-control",
    "pkief.material-icon-theme",
    "visualstudioexptteam.vscodeintellicode",
    "joelkarpintsev.es7-react-js-snippets",
    "yzhang.markdown-pdf",
    "streetsidesoftware.code-spells",
    "redhat.vscode-yaml",
    "github.vscode-pull-request-github",
    "hbenl.vscode-test-explorer",
    "builder.io.vercel",
    "pubnub/pubnub-channels",
    "rebornix.Vue",
    "octref.vetur",
    "github.copilot",
    "coenraads.bracket-pair-colorizer-2",
    "rajaa.jsonviewer",
    "johnpapa.vscode-linters",
    "waynejohnson.encoding-helpers",
    "gruntfuggly.object-browser",
    "fabiospampinato.vscode-adjacent-tab",
    "mikestead.vim-language-support",
    "ms-vsliveshare.vsls",
    "wmaurer.alpinejs-intellisense",
    "wallabyjs.wallaby-vscode",
    "codezombiech.gitignore",
    "yzhang.markdown-pdf",
    "tezzer00.goland-vscode",
    "sebastianjansen.vscode-file-icons",
    "mhutchie.git-graph",
    "mechatronist.vscode-js-docstrings",
    "stevelomography.git-related"
  ],

  "settings": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.smoothScrolling": true,
    "editor.minimap.enabled": true,
    "editor.renderLineHighlight": "gutter",
    "editor.wordWrap": "on",
    "workbench.colorTheme": "Default Dark+",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "git.autoCommit.onCommitMessageChange": false,
    "git.confirmForcePush": false,
    "git.enableLFS": true,
    "eslint.autoFixOnSave": "error",
    "eslint.formatOnSave": "file",
    "prettier.formatOnSave": "file",
    "search.exclude": {
      "**/.git": true,
      "**/.hg": true,
      "**/.svn": true,
      "**/.fslckout": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/.env*": true,
      "**/*.log": true,
      "**/*.out": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/coverage": true,
      "**/*.min.js": true,
      "**/*.map": true
    },
    "files.watcherExclude": {
      "**/node_modules/.bin": true,
      "**/.git": true,
      "**/build": true,
      "**/dist": true
    },
    "terminal.integrated.shell.linux": "/bin/bash",
    "python.pythonPath": "/usr/local/bin/python3",
    "php.validate.runInTerminalOnError": true,
    "php.snippetsFolder": "/usr/share/php" // Continue with the remaining extensions array...
  },

  "remoteUser": "root",

  "ports": [],

  "forwardPorts": [3000],

  "postCreateCommand": "npm install",

  "workspaceFolder": "/home/marthamarinho/Programming/git-clones/crud-produtos-reactjs",

  "customizations": {
    "git": {
      "autoCommitOnMerge": false,
      "enableSmartCommit": true,
      "pathLength": 50,
      "autoPull": false
    },
    "terminal": {
      "workbench": {
        "splitPath": "axes",
        "killOnClose": "deleteItem"
      }
    },
    "problems": {
      "fileSelector": "**/package.json"
    }
  }
}